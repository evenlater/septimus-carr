[
{{- $posts := where .Site.RegularPages "Type" "posts" -}}
{{- range $i, $p := $posts -}}
{{- if $i }},{{ end -}}
{
  "title": {{ $p.Title | markdownify | jsonify }},
  "url": {{ $p.Permalink | jsonify }},
  "date": {{ $p.Date.Format "January 2, 2006" | jsonify }},
  "tags": {{ $p.Params.tags | jsonify }},
  "text": {{ printf "%s %s" $p.Title $p.Plain | jsonify }}
}
{{- end -}}
]
